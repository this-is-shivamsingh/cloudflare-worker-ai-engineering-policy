{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engineering-policy-copilot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EngineeringPolicyAgent",
        "class_name": "EngineeringPolicyAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EngineeringPolicyAgent"]
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "observability": {
    "enabled": false
  }
}
